<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package (MSIX) for Cerebra. Built by the "Microsoft Store package" job in
  .github/workflows/release.yml from the Windows .msi; __VERSION__ and __EXE__ are filled in there.
  The identity values come from Partner Center → Cerebra → Product identity and must match exactly.
  The package is not signed here: the Store signs it after certification.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="KawaiiInosuke.Cerebra"
    Publisher="CN=F1E2F25E-9D6E-443E-B0B1-B59C1E745E62"
    Version="__VERSION__.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Cerebra</DisplayName>
    <PublisherDisplayName>Kawaii Inosuke</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Windows virtualizes this package's writes to %APPDATA% (Microsoft declined the
         unvirtualizedResources capability). Cerebra's own data lives there and stays consistent for the
         app and its connector; only Claude Desktop, whose settings are in %APPDATA%, is set up by hand
         (see connector::manual_setup). -->
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Cerebra" Executable="__EXE__" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Cerebra"
        Description="Turn your notes, PDFs and slides into a connected brain."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- `cerebra.exe` in %LOCALAPPDATA%\Microsoft\WindowsApps, so Claude Desktop, Codex and Cursor can
             start the connector (they can't start programs inside WindowsApps directly). -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="__EXE__" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="cerebra.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="cerebra">
            <uap:DisplayName>Cerebra share file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.cerebra</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
